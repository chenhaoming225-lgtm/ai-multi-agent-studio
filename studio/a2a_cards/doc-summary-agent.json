{
  "name": "doc-summary-agent",
  "description": "文档摘要管家：输入长文本/Markdown，输出精炼摘要与要点清单。支持流式输出。",
  "supportedInterfaces": [
    { "url": "http://127.0.0.1:8020/rpc", "protocolBinding": "JSONRPC", "protocolVersion": "1.0" }
  ],
  "version": "0.1.0",
  "capabilities": { "streaming": true, "pushNotifications": false },
  "defaultInputModes": ["text/plain", "text/markdown"],
  "defaultOutputModes": ["text/plain", "text/markdown"],
  "skills": [
    {
      "id": "doc-summarize",
      "name": "文档摘要",
      "description": "把长文档压缩成 3-5 条要点",
      "tags": ["summary", "doc"],
      "examples": ["帮我总结这份报告", "提炼这份文档的要点"]
    }
  ]
}